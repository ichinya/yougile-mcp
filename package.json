{
  "name": "yougile-mcp",
  "version": "1.3.0",
  "description": "A CLI and MCP server for YouGile",
  "main": "yougile.js",
  "bin": {
    "yougile": "./bin/yougile.cjs"
  },
  "type": "module",
  "scripts": {
    "start": "node yougile.js",
    "build": "tsc",
    "check": "npm run format:check && npm run lint && npm test",
    "format": "prettier --write src test bin *.{js,cjs,json,md}",
    "format:check": "prettier --check src test bin *.{js,cjs,json,md}",
    "lint": "eslint .",
    "test": "npm run build && node --test --test-concurrency=1 test/**/*.test.js",
    "cli": "node build/cli.js",
    "dev": "nodemon --watch src --ext ts --exec \"npm run build\" && node build/index.js",
    "serve": "npm run build && node build/index.js"
  },
  "keywords": [
    "yougile",
    "cli"
  ],
  "author": "",
  "license": "MIT",
  "overrides": {
    "minimatch": "^11.0.9"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.1",
    "dotenv": "^17.4.2",
    "yargs": "^18.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/yargs": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  }
}
